# VentoStack Admin — 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ---- 应用 ----
NODE_ENV=production
PORT=9320
HOST=0.0.0.0

# ---- 数据库 ----
DB_USER=vento
DB_PASSWORD=change-me
DB_NAME=ventostack
DB_PORT=5432
DATABASE_URL=postgres://vento:change-me@localhost:5432/ventostack

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- 安全 ----
JWT_SECRET=change-me-at-least-32-chars-long
BCRYPT_COST=10

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:9320

# ---- 日志 ----
LOG_LEVEL=info

# ---- 存储 ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# ---- WebAuthn ----
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=VentoStack Admin
