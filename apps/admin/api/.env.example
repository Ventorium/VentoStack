# ============================================================
# VentoStack Backend — 环境变量说明
# ============================================================
# 复制此文件为 .env 并按需修改

# ---- 运行环境 ----
NODE_ENV=development                         # development | production | test

# ---- HTTP 服务 ----
PORT=9320
HOST=0.0.0.0

# ---- 管理端口（/health, /metrics, /docs）----
# 独立端口默认绑定 127.0.0.1，仅本地访问
# 设为 0 则禁用独立端口，回退到主端口
ADMIN_PORT=9322
ADMIN_HOST=127.0.0.1

# ---- 数据库 ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ventostack

# ---- 认证 ----
JWT_SECRET=change-me-in-production-min-32-chars!!
SESSION_TTL_SECONDS=1800
MAX_DEVICES_PER_USER=5
BCRYPT_COST=10

# ---- 多租户 ----
TENANT_ENABLED=false                             # true | false（默认 false，启用后全局自动注入 tenant_id 隔离）

# ---- AI（启用后加密密钥必须恰好 32 字节）----
AI_ENABLED=false
# AI_CREDENTIAL_ENCRYPTION_KEY=change-this-ai-key-exactly-32byte
AI_DEFAULT_MODEL=default
AI_STORAGE_PATH=./data/ai

# ---- 对话渠道（微信 / QQ / 飞书 / 企业微信 / 钉钉 / MQTT）----
# 需 AI_ENABLED=true 才生效；关掉整个模块用 AI_CHANNEL_ENABLED=false
AI_CHANNEL_ENABLED=true
# webhook 类渠道（QQ / 飞书 / 企微 / 钉钉）要把回调地址填回平台，
# 这里必须是对外可访问的地址；不配时页面会提示「需先配置公网地址」，仅本地联调可留空
# AI_CHANNEL_PUBLIC_BASE_URL=https://ai.example.com
# 渠道未单独绑定 Agent 时的兜底 Agent；不配则按租户取第一个可用 Agent
# AI_CHANNEL_DEFAULT_AGENT_ID=
# 连接器（飞书/Notion/GitHub 等）OAuth 回调需要对外可访问地址，
# 必须与第三方平台注册的回调地址一致；不配时 OAuth 类连接器无法连接
# AI_PUBLIC_BASE_URL=https://ai.example.com

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:9321

# ---- 缓存 ----
CACHE_DRIVER=redis                           # memory | redis
REDIS_URL=redis://localhost:6379

# ---- 日志 ----
LOG_LEVEL=info                               # debug | info | warn | error

# ---- 存储 ----
STORAGE_DRIVER=local                         # local | s3
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_BASE_URL=/uploads

# S3（STORAGE_DRIVER=s3 时必填）
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://cdn.example.com
