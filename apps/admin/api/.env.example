# ============================================================
# VentoStack Backend — 环境变量说明
# ============================================================
# 复制此文件为 .env 并按需修改

# ---- 运行环境 ----
NODE_ENV=development                         # development | production | test

# ---- HTTP 服务 ----
PORT=9320
HOST=0.0.0.0

# ---- 管理端口（/health, /metrics, /docs）----
# 独立端口默认绑定 127.0.0.1，仅本地访问
# 设为 0 则禁用独立端口，回退到主端口
ADMIN_PORT=9322
ADMIN_HOST=127.0.0.1

# ---- 数据库 ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ventostack

# ---- 认证 ----
JWT_SECRET=change-me-in-production-min-32-chars!!
SESSION_TTL_SECONDS=1800
MAX_DEVICES_PER_USER=5
BCRYPT_COST=10

# ---- 多租户 ----
TENANT_ENABLED=false                             # true | false（默认 false，启用后全局自动注入 tenant_id 隔离）

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:9321

# ---- 缓存 ----
CACHE_DRIVER=redis                           # memory | redis
REDIS_URL=redis://localhost:6379

# ---- 日志 ----
LOG_LEVEL=info                               # debug | info | warn | error

# ---- 存储 ----
STORAGE_DRIVER=local                         # local | s3
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_BASE_URL=/uploads

# S3（STORAGE_DRIVER=s3 时必填）
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://cdn.example.com
