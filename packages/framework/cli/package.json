{
  "name": "@ventostack/cli",
  "version": "0.1.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ventorium/VentoStack.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ventostack": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "templates"],
  "dependencies": {
    "@ventostack/core": "workspace:*",
    "@ventostack/database": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}
